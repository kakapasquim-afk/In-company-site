# Chave da API do Resend — NUNCA commit o valor real (use seu .env local).
# Deve ficar apenas no ambiente do servidor (Vercel: Settings > Environment Variables).
RESEND_API_KEY=

# Remetente autorizado no Resend (após verificar seu domínio).
# Ex.: "Unipar In Company <contato@seusite.com.br>"
# Se vazio, o Resend usa o sandbox "onboarding@resend.dev" (teste).
RESEND_FROM_EMAIL=

# Destinatário fixo dos contatos do site.
RESEND_TO_EMAIL=celso.ferrari@prof.unipar.br